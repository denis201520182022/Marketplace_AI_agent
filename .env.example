# ==============================================================================
# AI for Salers — Environment Configuration Template
# ==============================================================================

# Общие настройки окружения
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Настройки FastAPI приложения
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL 16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_for_salers
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_for_salers

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# RabbitMQ 3.13
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ==============================================================================
# Безопасность и шифрование (AES-256-GCM)
# Сгенерировать мастер-ключ можно командой:
# python -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================
SECRET_KEY_ENCRYPTION=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# Сетевая топология и Прокси (Hybrid & Sovereign Modes)
# USE_PROXY=true — для обхода блокировок TG Bot API и OpenAI через forward proxy (JustHost)
# USE_PROXY=false — прямой доступ (суверенный контур РФ, MAX, GigaChat/YandexGPT)
# ==============================================================================
USE_PROXY=false
PROXY_URL=http://user:password@proxy.example.com:3128

# ==============================================================================
# Боты (Telegram & MAX / VK)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
# Список ID администраторов (через запятую или JSON-массив)
ADMIN_TELEGRAM_IDS=123456789
ADMIN_MAX_IDS=max_user_guid_123

# ==============================================================================
# LLM Провайдер (OpenAI / Прокси)
# ==============================================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini


LANGFUSE_PUBLIC_KEY=lf-pk-local-change-me
LANGFUSE_SECRET_KEY=lf-sk-local-change-me
LANGFUSE_HOST=http://localhost:3002


# ==============================================================================
# Платёжный шлюз (ЮKassa)
# ==============================================================================
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
